    <selectionEntry name="Dwarf Axemen Charge" id="563f-a518-a9f5-276f" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1137-e259-fd39-abe1" field="selections" scope="parent" shared="true" type="max" value="1"/>
