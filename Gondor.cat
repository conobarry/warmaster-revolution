        <profile name="Citadel Guard" id="9c4e-4791-7981-ef59" hidden="false" typeId="a5d3-6ea8-6425-5123" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="bc69-55f2-6b4e-18e7">The Elite infantry sworn to protect the Steward of Gondor. The Guard can only be fielded if Denethor, Boromir, or Faramir are present for a battle, and only if the battle takes place at Minas Tirith.</characteristic>
          </characteristics>
