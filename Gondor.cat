    <selectionEntry type="unit" import="true" name="Field Trebuchet" hidden="false" id="3086-2c51-ec89-d1e5">
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="2bc6-a5e8-b715-256f" shared="true" childName="Show Homebrew" includeChildSelections="true" includeChildForces="true"/>
