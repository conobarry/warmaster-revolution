    <selectionEntry name="Field Trebuchet" id="3086-2c51-ec89-d1e5" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Artillery" id="0407-9d95-a80e-32ba" hidden="false" primary="true" targetId="ab71-7ddd-db90-f5e5"/>
      </categoryLinks>
