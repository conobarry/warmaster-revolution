    <selectionEntry name="Mûmakil" id="1647-4fe3-3da4-c316" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Monster" id="5b9b-bc1e-0a89-2167" hidden="false" primary="true" targetId="c05d-61e2-2cbd-0df9"/>
      </categoryLinks>
      <constraints>
        <constraint id="3b3c-24bf-e1c2-9ae9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="0"/>
      </constraints>
