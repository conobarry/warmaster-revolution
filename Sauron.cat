      <rules>
        <rule name="Grond" id="1add-18df-fc15-4de8" hidden="false">
          <description>Grond uses the normal battering ram rules except that it does two automatic hits, and only needs one breach to destroy a wall or gate. A unit of trolls must be bought to wield Grond. Grond has a movement of 10cm unless pulled by beasts.</description>
        </rule>
      </rules>
