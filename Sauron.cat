    <selectionEntry type="unit" import="true" name="Trolls" hidden="false" id="04e1-e02a-1303-6b07" publicationId="2fdc-4bd3-bba1-56b9">
      <costs>
        <cost name="pts" typeId="2085-9b6f-c588-0723" value="105"/>
      </costs>
