    <selectionEntry type="unit" import="true" name="Wolfrider Archers" hidden="false" id="f922-b95b-bc4d-5aee">
      <costs>
        <cost name="pts" typeId="2085-9b6f-c588-0723" value="60"/>
      </costs>
      <profiles>
        <profile name="Wolfrider Archers" typeId="939e-319b-8950-616f" typeName="Unit" hidden="false" id="537c-6c2f-de28-57c6">
          <characteristics>
            <characteristic name="Type" typeId="3087-9431-0004-e975">Cavalry</characteristic>
            <characteristic name="Attacks" typeId="ce3c-e837-0a09-dba6">2/1</characteristic>
            <characteristic name="Hits" typeId="f51a-b726-0fbe-0569">3</characteristic>
            <characteristic name="Armour" typeId="1b25-0ce9-c54e-e226">6+</characteristic>
            <characteristic name="Command" typeId="73c2-d4e8-04e7-dcbc">-</characteristic>
            <characteristic name="Unit size" typeId="72b4-6deb-0f8e-7f27">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Wolfrider Archers" typeId="a5d3-6ea8-6425-5123" typeName="Ability" hidden="false" id="7ee0-dec0-7638-4c17">
          <characteristics>
            <characteristic name="Description" typeId="bc69-55f2-6b4e-18e7">A Wolf Rider stand is assumed to be able to see all the way round – not just to its front as are other stands. This enables Wolf Riders to shoot in any direction, or to charge or evade from the closest enemy within 20cm regardless of their relative position.</characteristic>
          </characteristics>
        </profile>
