        <profile name="Wolfriders" typeId="a5d3-6ea8-6425-5123" typeName="Ability" hidden="false" id="6dd4-336b-0f06-a9ce">
          <characteristics>
            <characteristic name="Description" typeId="bc69-55f2-6b4e-18e7">When Wolfriders are in combat with a mounted unit, and score more hits in the first round of a combat than the enemy, they will automatically strike 1 more Attack per stand before the combat results are worked out. Resolve these attacks as normal and then work out the results.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Cavalry" hidden="false" id="55e6-9c7e-9f5a-6416" targetId="6bff-b94d-a54a-8758" primary="true"/>
      </categoryLinks>
