      </infoLinks>
      <rules>
        <rule name="Uruk-hai" id="552c-34e6-a4de-293e" hidden="false">
          <description>A regiment with Uruk-hai and Orcs suffers a -1 Command penalty. To represent the speed and aggression of the Uruk-hai they use the Warband rules, and may always advance 20 cm after combat regardless of how many rounds the initial combat engagement took.</description>
        </rule>
      </rules>
    </selectionEntry>
